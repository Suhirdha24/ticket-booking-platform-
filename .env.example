# MongoDB Atlas Connection URI (Required)
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ticket-booking-platform?retryWrites=true&w=majority

# JWT Authentication Secret (Required)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# QR Cryptographic HMAC Signing Key (Required)
QR_SECRET=your_super_secret_qr_hmac_key_2026

# Admin Registration Secret Key (Optional - for securing admin registration)
ADMIN_SECRET=eventhub_admin_secret_key_2026

# Port for Local Development Server Only
PORT=5000
NODE_ENV=development
