{
  "name": "bookverse-recommendation-platform",
  "version": "1.0.0",
  "description": "Production-ready Book Recommendation and Reading Discovery Platform",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --watch-path=server server/server.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix client install",
    "seed": "node server/scripts/seedBooks.js",
    "seed:books": "node server/scripts/seedBooks.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "book-recommendation",
    "reading-platform",
    "vibe-matcher",
    "bookshelf-tracker",
    "vercel-serverless",
    "mongodb-atlas",
    "react",
    "express"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
